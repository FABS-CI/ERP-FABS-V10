# Dockerfile Frontend — Railway
FROM node:18-slim AS builder

WORKDIR /app
COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile
COPY frontend/ .
RUN yarn build

FROM nginx:alpine
RUN apk add --no-cache wget gettext

COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.railway.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.frontend.sh /docker-entrypoint.frontend.sh
RUN chmod +x /docker-entrypoint.frontend.sh

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["/docker-entrypoint.frontend.sh"]
