# ============================================================
# ERP FABS-CI V10 — Variables d'environnement PRODUCTION
# Copier ce fichier vers backend/.env et remplir toutes les valeurs
# NE JAMAIS committer backend/.env
# ============================================================

# --- MongoDB ---
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_URL=mongodb://admin:CHANGE_ME_STRONG_PASSWORD@mongodb:27017
DB_NAME=fabsci_erp

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# --- JWT ---
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_64_CHARS_MINIMUM
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# --- CORS (URL du frontend en prod) ---
CORS_ORIGINS=https://erp.editionsfabsci.com

# --- Environnement ---
ENVIRONMENT=production
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=false

# --- Email (optionnel) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@editionsfabsci.com

# --- Google Drive backup (optionnel) ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
