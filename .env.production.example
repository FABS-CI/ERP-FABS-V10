# ============================================================
# ERP FABS-CI V10 — Variables d'environnement PRODUCTION
# Copier ce fichier en .env et remplir toutes les valeurs
# NE JAMAIS committer .env dans git
# ============================================================

# ---- MongoDB -----------------------------------------------
MONGO_ROOT_PASSWORD=changeme_strong_password_here
# MONGO_URL est construit automatiquement dans docker-compose.yml

# ---- JWT ---------------------------------------------------
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=changeme_64chars_minimum_random_string

# ---- CORS --------------------------------------------------
# Liste des origines frontend autorisées (séparées par virgule, sans espace)
# Exemple : https://erp.fabsci.ci,https://www.erp.fabsci.ci
CORS_ORIGINS=https://erp.fabsci.ci

# ---- Environnement -----------------------------------------
ENVIRONMENT=production

# ---- Tokens JWT --------------------------------------------
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ---- Redis -------------------------------------------------
# En Docker Compose, redis://redis:6379 (service interne)
# REDIS_URL est déjà défini dans docker-compose.yml

# ---- Notifications (optionnel) -----------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@fabsci.ci
# SMTP_PASSWORD=changeme
# SMTP_FROM=ERP FABS-CI <noreply@fabsci.ci>

# ---- Monitoring (optionnel) --------------------------------
# Mettre à false pour désactiver l'exposition /metrics
PROMETHEUS_ENABLED=false
