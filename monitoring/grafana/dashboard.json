{
  "dashboard": {
    "title": "ERP FABS-CI Monitoring",
    "uid": "erp-fabsci-monitoring",
    "tags": ["erp", "monitoring"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "API Requests per Second",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"erp-backend\"}[1m])",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          }
        ]
      },
      {
        "id": 2,
        "title": "API Response Time (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"erp-backend\"}[1m]))",
            "legendFormat": "p95 Response Time"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Seconds"
          }
        ]
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"erp-backend\",status=~\"5..\"}[1m]) / rate(http_requests_total{job=\"erp-backend\"}[1m]) * 100",
            "legendFormat": "Error Rate %"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "Error Rate"
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  {
                    "type": "query",
                    "params": ["A", "5min", "now"]
                  }
                ],
                "type": "query"
              },
              "operator": {
                "type": "gt"
              },
              "query": {
                "params": ["A", "5", "avg", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "High Error Rate Alert",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 4,
        "title": "MongoDB Connection Pool",
        "type": "stat",
        "targets": [
          {
            "expr": "mongodb_connections_pool{job=\"erp-backend\"}",
            "legendFormat": "Active Connections"
          }
        ]
      },
      {
        "id": 5,
        "title": "Redis Connection Pool",
        "type": "stat",
        "targets": [
          {
            "expr": "redis_connections_pool{job=\"erp-backend\"}",
            "legendFormat": "Active Connections"
          }
        ]
      },
      {
        "id": 6,
        "title": "Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=\"erp-backend\"} / 1024 / 1024",
            "legendFormat": "Memory MB"
          }
        ],
        "yaxes": [
          {
            "format": "decmbytes",
            "label": "Memory (MB)"
          }
        ]
      },
      {
        "id": 7,
        "title": "CPU Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total{job=\"erp-backend\"}[1m]) * 100",
            "legendFormat": "CPU %"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "CPU Usage"
          }
        ]
      },
      {
        "id": 8,
        "title": "Active Users",
        "type": "stat",
        "targets": [
          {
            "expr": "count(rate(http_requests_total{job=\"erp-backend\",endpoint=\"/auth/login\"}[5m]))",
            "legendFormat": "Active Users (5min)"
          }
        ]
      },
      {
        "id": 9,
        "title": "Database Operations",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(mongodb_operations_total{job=\"erp-backend\"}[1m])",
            "legendFormat": "{{operation}}"
          }
        ]
      },
      {
        "id": 10,
        "title": "Cache Hit Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(cache_hits_total{job=\"erp-backend\"}[1m]) / (rate(cache_hits_total{job=\"erp-backend\"}[1m]) + rate(cache_misses_total{job=\"erp-backend\"}[1m])) * 100",
            "legendFormat": "Cache Hit Rate %"
          }
        ]
      }
    ]
  }
}
