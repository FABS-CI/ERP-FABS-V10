# --- JWT Security ---
JWT_SECRET=03420f65b3c053ebb3ac5b874c11b76cd55cb2940464013a731f091f4fd96f4d6430a36449c5e7aa990c148d63437d2b021ce45e6167919e6f75fb7b70040920
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# --- CORS (Whitelist STRICT pour prod) ---
CORS_ORIGINS=https://erp.editionsfabsci.com,https://app.editionsfabsci.com

# --- Security Headers ---
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# --- Rate Limiting (Prod) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=120

# --- File Storage ---
FILE_STORAGE_PATH=/data/uploads
MAX_UPLOAD_SIZE_MB=100

# --- Email (DGI/Notifications) ---
SMTP_HOST=smtp.editionsfabsci.com
SMTP_PORT=587
SMTP_USERNAME=erp@editionsfabsci.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=erp@editionsfabsci.com
SMTP_USE_TLS=true

# --- DGI Compliance ---
DGI_ENABLED=true
DGI_ENVIRONMENT=production
DGI_CERTIFICATE_PATH=/etc/certs/dgi-cert.pem

# --- Backup & Disaster Recovery ---
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=fabsci-backups-prod

# --- Monitoring & Alerting ---
SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
DATADOG_API_KEY=CHANGE_ME_DATADOG_KEY
ALERT_EMAIL=devops@editionsfabsci.com

# --- TLS/SSL ---
TLS_ENABLED=true
TLS_CERT_PATH=/etc/certs/server.crt
TLS_KEY_PATH=/etc/certs/server.key

# --- Database Optimization ---
DB_POOL_SIZE=20
DB_POOL_MIN=5
DB_IDLE_TIMEOUT_MS=60000
DB_TIMEOUT_MS=10000

# --- Feature Flags ---
FEATURE_2FA=true
FEATURE_AUDIT_LOG=true
FEATURE_ENCRYPTION=true
FEATURE_NOTIFICATIONS=true
FEATURE_ANALYTICS=true

# ============================================================
# IMPORTANT: Replace CHANGE_ME values with actual secrets
