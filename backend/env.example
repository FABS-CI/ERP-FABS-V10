# ============================================================================
# ERP FABS-CI — Variables d'environnement
# Copier vers backend/.env et remplir les valeurs
# NE JAMAIS committer le fichier .env
# ============================================================================

# Environnement
ENVIRONMENT=production
LOG_LEVEL=INFO

# MongoDB Atlas (obligatoire en production)
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=fabsci_erp_production

# Redis (Render.com managed)
REDIS_URL=redis://red-XXXXXX.render.com:6379

# JWT — Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_THIS_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# CORS — URL exacte du frontend (sans slash final)
CORS_ORIGINS=https://erp-fabs-frontend.onrender.com

# Comptes initiaux (seeding au 1er démarrage uniquement)
# CHANGER ces mots de passe après le 1er déploiement
SUPER_ADMIN_EMAIL=pissken@editionsfabsci.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS
SUPER_ADMIN_NAME=Super Admin

DG_EMAIL=ali.mamin@editionsfabsci.com
DG_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS
DG_NAME=ALI MAMIN

# Prometheus (désactivé par défaut en production)
PROMETHEUS_ENABLED=false

# Signing (désactivé — réactiver si frontend implémente les headers)
# SIGNING_KEY=CHANGE_THIS_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_64
