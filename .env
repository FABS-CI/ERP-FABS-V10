# ERP FABS-CI V10 — Configuration environnement
# ATTENTION : Ce fichier est versionné. NE PAS mettre de secrets ici.
# Les secrets de production sont dans /etc/erp-fabs.env (chmod 600)
#
# Pour le développement local, copier env.example vers backend/.env

ENVIRONMENT=production
MONGO_URL=mongodb://fabsci_app:FabsCI_App_2026!@localhost:27017/fabsci_erp?authSource=fabsci_erp
DB_NAME=fabsci_erp
REDIS_URL=redis://:FabsCI_Redis_2026!@localhost:6379

# JWT — La clé réelle est dans /etc/erp-fabs.env
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# CORS — Restreint aux domaines autorisés
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=INFO
PROMETHEUS_ENABLED=false
FORCE_HTTPS=false
BACKUP_ENABLED=true
BACKUP_PATH=/home/user/erp-backups
BACKUP_RETENTION_DAYS=30
S3_ENABLED=false
SMTP_ENABLED=false
